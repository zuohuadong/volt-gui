# Copy to .env and fill in. Only secrets belong here — a provider's base_url and
# model are configured in voltui.toml, where api_key_env points at these variables.

# Volt internal model gateway (http://192.168.1.47:9010/v1)
XG_GOMODEL_API_KEY=

# 以下为可选的外部 provider key
DEEPSEEK_API_KEY=
MIMO_API_KEY=
ANTHROPIC_API_KEY=

# Optional integrations. Keep these disabled unless the project owner explicitly enables them.
ANYONG_WEB_RETRIEVAL_ENABLED=0
ANYONG_GITHUB_ENABLED=0
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_ALLOWED_HOSTS=
ANYONG_CNB_ENABLED=0
CNB_TOKEN=
CNB_API_ENDPOINT=https://api.cnb.cool
CNB_ALLOWED_HOSTS=
CNB_REPO_SLUG=
ANYONG_SENTRY_ENABLED=1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_BASE_URL=https://sentry.io/api/0
SENTRY_ALLOWED_HOSTS=
ANYONG_FEISHU_ENABLED=0
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_HOSTS=
ANYONG_FEISHU_WRITE_ENABLED=0
ANYONG_DOCUMENT_IMPORT_ENABLED=1
ANYONG_IMPORT_ROOT=
ANYONG_OCR_COMMAND=
ANYONG_OCR_ARGS_JSON=["{{file}}"]
WEKNORA_BASE_URL=http://localhost:8080/api/v1
WEKNORA_ALLOWED_HOSTS=
WEKNORA_API_KEY=
WEKNORA_TENANT_ID=
WEKNORA_KNOWLEDGE_BASE_IDS=
WEKNORA_AGENT_ID=
WEKNORA_ASK_ENABLED=0
ANYONG_WEKNORA_INGEST_ENABLED=0
WEKNORA_INGEST_URL=
