{
  "appId": "com.volt.anyong.dsh",
  "productName": "Anyong DSH",
  "directories": {
    "output": "dist-package"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "icon": "../../desktop/build/windows/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
