{
  "name": "@voltui/desktop-electron",
  "version": "0.31.56",
  "description": "西谷智灯暗涌平台 desktop shell for the official DeepSeek Harness runtime",
  "main": "dist/main.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/ensure-pnpm.mjs",
    "pretest": "node ../../scripts/ensure-pnpm.mjs",
    "build:main": "node ./scripts/build-main.mjs",
    "build:frontend": "pnpm --dir ../desktop-frontend build",
    "build": "pnpm run build:frontend && pnpm run build:main",
    "predist": "node ../../scripts/ensure-pnpm.mjs && node ../../scripts/stage-bundled-model-credentials.mjs",
    "typecheck": "tsc --noEmit",
    "test:profile": "node --test ../../scripts/electron-profile.test.mjs",
    "test:runtime": "node --test ./scripts/*.test.mjs ./src/*.test.ts ./src/main-lifecycle.test.mjs ../../scripts/stage-bundled-model-credentials.test.mjs",
    "test:smb": "node --test ./src/smb-mounts.test.ts",
    "test:security": "node --test ../../scripts/check-electron-runtime-boundary.test.mjs",
    "test": "pnpm run typecheck && pnpm run test:profile && pnpm run test:runtime && pnpm run test:smb && pnpm run test:security",
    "dev": "tsc --watch --noEmit",
    "install:electron": "node ../../scripts/install-electron-runtime.mjs",
    "start": "pnpm run install:electron && pnpm run stage:runtime && electron dist/main.js",
    "stage:browser-skill": "node ./scripts/stage-browser-skill-cli.mjs",
    "stage:browser-extension": "node ./scripts/stage-browser-extension.mjs",
    "stage:tools": "node ./scripts/stage-desktop-tools.mjs",
    "stage:speech": "node ../../scripts/stage-speech-model.mjs",
    "stage:runtime": "node ./scripts/stage-dsh-runtime.mjs",
    "smoke:package": "node ../../scripts/smoke-packaged-dsh-runtime.mjs",
    "dist": "pnpm run install:electron && pnpm run stage:runtime && pnpm run stage:browser-extension && pnpm run stage:speech && node ./scripts/build-electron-artifacts.mjs"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "3.3.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@voltui/dsh-intranet-auth": "file:../../plugins/dsh-intranet-auth",
    "@voltui/dsh-office": "file:../../plugins/dsh-office",
    "@voltui/dsh-mcp-apps": "file:../../plugins/dsh-mcp-apps",
    "@voltui/dsh-native-ui": "file:../../plugins/dsh-native-ui",
    "@officecli/officecli": "1.0.159",
    "@wxg-prc-cpg/browser-skill-dsh-plugin": "0.4.0",
    "@wxg-prc-cpg/dsh-weknora": "0.1.0",
    "dsh-ab-ocr": "0.1.19",
    "memorix": "1.10.1",
    "undici": "8.12.3",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "author": "西谷智灯暗涌平台 contributors"
}
