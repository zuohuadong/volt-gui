{
  "name": "@voltui/desktop-electron",
  "version": "1.0.0",
  "description": "VoltUI desktop application powered by Electron, DSH and Svelte 5",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build:main": "node ./scripts/build-main.mjs",
    "build:frontend": "pnpm --filter voltui-desktop-workbench run build:electron && node ./scripts/build-frontend.mjs",
    "build": "pnpm run build:frontend && pnpm run build:main",
    "test:config": "node --test src/runtime-config.test.mjs",
    "test:profile": "node --test ../../scripts/electron-profile.test.mjs",
    "test:security": "node ./scripts/run-security-tests.mjs",
    "dev": "tsc --watch",
    "start": "electron dist/main.js",
    "dist": "electron-builder --config electron-builder.mjs --win --x64"
  },
  "devDependencies": {
    "@dsh/core": "workspace:*",
    "@dsh/plugins": "workspace:*",
    "@dsh/server": "workspace:*",
    "@types/node": "^22.13.10",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2"
  },
  "author": "VoltUI contributors"
}
