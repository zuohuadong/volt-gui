{
  "name": "@voltui/desktop-electron",
  "version": "1.0.0",
  "description": "VoltUI desktop shell for the official DeepSeek Harness runtime",
  "main": "dist/main.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:main": "node ./scripts/build-main.mjs",
    "build": "pnpm run build:main",
    "typecheck": "tsc --noEmit",
    "test:profile": "node --test ../../scripts/electron-profile.test.mjs",
    "test:runtime": "node --test ./src/official-dsh-runtime.test.ts",
    "test:security": "node --test ../../scripts/check-electron-runtime-boundary.test.mjs",
    "test": "pnpm run typecheck && pnpm run test:profile && pnpm run test:runtime && pnpm run test:security",
    "dev": "tsc --watch --noEmit",
    "start": "pnpm run stage:runtime && electron dist/main.js",
    "stage:runtime": "node ./scripts/stage-dsh-runtime.mjs",
    "smoke:package": "node ../../scripts/smoke-packaged-dsh-runtime.mjs",
    "dist": "pnpm run stage:runtime && electron-builder --config electron-builder.mjs --win --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "author": "VoltUI contributors"
}
