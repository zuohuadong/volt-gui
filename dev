#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

command -v pnpm >/dev/null 2>&1 || {
  echo "dev: pnpm is required" >&2
  exit 1
}

export VOLTUI_DEV=1
export npm_config_confirm_modules_purge=false
export npm_config_minimum_release_age=0

echo "VoltUI Electron/DSH desktop dev"
echo "  worktree: $root"

exec pnpm run desktop -- "$@"
