{
  "name": "dsh-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "anyong": "./scripts/anyong.mjs",
    "dsh-anyong": "./scripts/anyong.mjs"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build && node ./scripts/bundle.mjs",
    "test": "pnpm -r --filter './packages/*' run test",
    "start": "./scripts/anyong.mjs",
    "web": "./scripts/anyong.mjs web",
    "desktop": "pnpm --filter @anyong/desktop-electron run build:main && pnpm --filter @anyong/desktop-electron run start",
    "build:desktop": "pnpm --filter @anyong/desktop-electron run build",
    "dsh": "pnpm --filter @dsh/cli run dev",
    "bundle": "node ./scripts/bundle.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10"
  }
}
