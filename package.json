{
  "name": "dsh-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "anyong": "./scripts/anyong.mjs",
    "dsh-anyong": "./scripts/anyong.mjs"
  },
  "scripts": {
    "build": "pnpm --filter \"@dsh/*\" --filter \"@xgic/*\" run build && node ./scripts/bundle.mjs",
    "test": "pnpm --filter \"@dsh/*\" --filter \"@xgic/*\" run test",
    "test:dsh-integration": "node --test ./scripts/dsh-integration.test.mjs",
    "start": "./scripts/anyong.mjs",
    "web": "./scripts/anyong.mjs web",
    "desktop": "pnpm --filter @voltui/desktop-electron run build && pnpm --filter @voltui/desktop-electron run start",
    "build:desktop": "pnpm --filter @voltui/desktop-electron run build",
    "dist:desktop": "pnpm --filter @voltui/desktop-electron run build && pnpm --filter @voltui/desktop-electron run dist && node ./scripts/package-dist.mjs",
    "dsh": "pnpm --filter @dsh/cli run dev",
    "bundle": "node ./scripts/bundle.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10"
  }
}
