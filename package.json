{
  "name": "volt-gui",
  "version": "0.31.27",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "packageManager": "pnpm@12.1.0",
  "bin": {
    "anyong": "./scripts/anyong.mjs",
    "dsh-anyong": "./scripts/anyong.mjs"
  },
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "prebuild": "node ./scripts/ensure-pnpm.mjs",
    "pretest": "node ./scripts/ensure-pnpm.mjs",
    "predist:desktop": "node ./scripts/ensure-pnpm.mjs",
    "build": "node ./scripts/bundle.mjs && pnpm run build:desktop",
    "test": "pnpm --filter @voltui/desktop-electron run test && node --test ./scripts/check-migration-boundary.test.mjs ./scripts/provision-dsh-profile.test.mjs ./scripts/smoke-packaged-dsh-runtime.test.mjs && pnpm run check:dsh-plugins",
    "test:dsh-integration": "node --test ./scripts/dsh-integration.test.mjs",
    "start": "node ./scripts/anyong.mjs",
    "web": "node ./scripts/anyong.mjs web",
    "desktop": "pnpm --filter @voltui/desktop-electron run build && pnpm --filter @voltui/desktop-electron run start",
    "build:desktop": "pnpm --filter @voltui/desktop-electron run build",
    "dist:desktop": "pnpm --filter @voltui/desktop-electron run build && pnpm --filter @voltui/desktop-electron run dist && pnpm --filter @voltui/desktop-electron run smoke:package && node ./scripts/package-dist.mjs",
    "dsh": "node ./scripts/anyong.mjs",
    "bundle": "node ./scripts/bundle.mjs",
    "check:dsh-plugins": "node ./scripts/check-dsh-plugin-compatibility.mjs",
    "setup:browser-skill": "node ./scripts/setup-browser-skill.mjs install",
    "check:browser-skill": "node ./scripts/setup-browser-skill.mjs check",
    "doctor:browser-skill": "node ./scripts/setup-browser-skill.mjs doctor"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@officecli/officecli": "1.0.146"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
