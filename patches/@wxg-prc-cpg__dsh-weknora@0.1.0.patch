+import { lookup } from "node:dns/promises";
+import { isIP } from "node:net";
+import { Agent, fetch } from "undici";
+import ipaddr from "ipaddr.js";
+
+const MAX_RESPONSE_BYTES = 4 * 1024 * 1024;
+
+export function permittedAddress(address, allowPrivateHosts) {
+    let parsed = ipaddr.parse(address);
+    if (parsed.kind() === "ipv6" && parsed.isIPv4MappedAddress())
+        parsed = parsed.toIPv4Address();
+    const range = parsed.range();
+    return range === "unicast" || (allowPrivateHosts && ["private", "uniqueLocal", "loopback"].includes(range));
+}
+
+export async function resolveDestination(url, signal, allowPrivateHosts, resolver = lookup) {
+    signal.throwIfAborted();
+    const hostname = url.hostname.replace(/^\[|\]$/g, "");
+    const family = isIP(hostname);
+    let abort;
+    const cancelled = new Promise((_, reject) => {
+        abort = () => reject(signal.reason);
+        signal.addEventListener("abort", abort, { once: true });
+    });
+    try {
+        const addresses = family ? [{ address: hostname, family }]
+            : await Promise.race([resolver(hostname, { all: true, order: "verbatim" }), cancelled]);
+        if (!addresses.length || addresses.some(entry => !permittedAddress(entry.address, allowPrivateHosts)))
+            throw new Error("WEKNORA_DESTINATION_BLOCKED");
+        return addresses;
+    } finally {
+        signal.removeEventListener("abort", abort);
+    }
+}
+
+export function pinnedLookup(addresses) {
+    return (_hostname, options, callback) => {
+        const matches = options.family ? addresses.filter(entry => entry.family === options.family) : addresses;
+        if (!matches.length) return callback(new Error("WEKNORA_ADDRESS_FAMILY"));
+        if (options.all) callback(null, matches);
+        else callback(null, matches[0].address, matches[0].family);
+    };
+}
+
+// Pin DNS and bound the entire response, including SSE, before exposing it to parsers.
+export async function boundedFetch(url, init, config) {
+    const destination = new URL(url);
+    if (destination.origin !== new URL(config.baseUrl).origin) throw new Error("WEKNORA_ORIGIN_BLOCKED");
+    if (!config.allowedOrigins.includes(destination.origin)) throw new Error("WEKNORA_ORIGIN_BLOCKED");
+    const addresses = await resolveDestination(destination, init.signal, config.allowPrivateHosts);
+    const dispatcher = new Agent({ connect: { lookup: pinnedLookup(addresses) } });
+    try {
+        const response = await fetch(destination, { ...init, dispatcher, redirect: "error" });
+        if (Number(response.headers.get("content-length")) > MAX_RESPONSE_BYTES) throw new Error("WEKNORA_RESPONSE_TOO_LARGE");
+        const chunks = [];
+        let bytes = 0;
+        for await (const chunk of response.body ?? []) {
+            bytes += chunk.byteLength;
+            if (bytes > MAX_RESPONSE_BYTES) throw new Error("WEKNORA_RESPONSE_TOO_LARGE");
+            chunks.push(Buffer.from(chunk));
+        }
+        const contentType = response.headers.get("content-type") ?? "";
+        if (response.ok && !contentType.includes("application/json") && !contentType.includes("text/event-stream"))
+            throw new Error("WEKNORA_INVALID_RESPONSE");
+        const body = [204, 205, 304].includes(response.status) ? null : Buffer.concat(chunks);
+        return new Response(body, { status: response.status, headers: response.headers });
+    } finally {
+        await dispatcher.destroy();
+    }
+}
