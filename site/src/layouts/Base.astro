---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description, titleEn = title, titleZh = title, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <meta name="theme-color" content="#f6f5f2" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="VoltUI" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <slot name="head" />
</head>
<body
  class={bodyClass}
  data-motion="rich"
  data-lang="en"
  data-title-en={titleEn}
  data-title-zh={titleZh}>
  <slot />
  <script>
    import '../scripts/fx.js';
    const buttons = Array.from(document.querySelectorAll('#lang'));
    const setLanguage = (value) => {
      const language = value === 'zh' ? 'zh' : 'en';
      document.body.dataset.lang = language;
      document.documentElement.lang = language;
      const title = document.body.dataset[language === 'zh' ? 'titleZh' : 'titleEn'];
      if (title) document.title = title;
      buttons.forEach((button) => { button.textContent = language === 'zh' ? 'EN' : '中文'; });
      try { localStorage.setItem('voltui-lang', language); } catch {}
    };
    buttons.forEach((button) => button.addEventListener('click', () => setLanguage(document.body.dataset.lang === 'zh' ? 'en' : 'zh')));
    let saved = '';
    try { saved = localStorage.getItem('voltui-lang') || ''; } catch {}
    setLanguage(saved || (navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en'));
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(button.dataset.copy || ''); } catch {}
      const old = button.textContent;
      button.textContent = document.body.dataset.lang === 'zh' ? '已复制' : 'Copied';
      setTimeout(() => { button.textContent = old; }, 1200);
    }));
  </script>
</body>
</html>
