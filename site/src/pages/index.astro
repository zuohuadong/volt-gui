---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="VoltUI — Electron + DeepSeek Harness" titleEn="VoltUI — Electron + DeepSeek Harness" titleZh="VoltUI — Electron + DeepSeek Harness 桌面工作台" description="VoltUI is a local Electron desktop shell around the official DeepSeek Harness runtime.">
  <SiteHeader active="home" />
  <main>
    <section class="enterprise-hero wrap">
      <div class="hero-copy">
        <div class="kicker"><span class="dot"></span><span class="l-en">Open source · Electron desktop · Official DSH</span><span class="l-zh">开源 · Electron 桌面端 · 官方 DSH</span></div>
        <h1><span class="l-en">A local agent workbench with one runtime contract.</span><span class="l-zh">一套运行时契约的本地 Agent 工作台。</span></h1>
        <p class="lede"><span class="l-en">VoltUI packages Electron around the official DeepSeek Harness web profile. The shell owns the window and lifecycle; DSH owns sessions, tools, permissions, credentials and storage.</span><span class="l-zh">VoltUI 以 Electron 封装官方 DeepSeek Harness Web Profile。Shell 负责窗口与生命周期，DSH 负责会话、工具、权限、凭据与存储。</span></p>
        <div class="hero-cta start"><a class="btn btn-dark" href={base + '/enterprise/'}><span class="l-en">Read the deployment contract</span><span class="l-zh">查看部署契约</span></a><a class="btn btn-line" href={base + '/docs/'}><span class="l-en">Open documentation</span><span class="l-zh">打开文档</span></a></div>
      </div>
      <div class="hero-system" aria-label="VoltUI runtime overview">
        <div class="system-head"><span class="system-status"></span><span class="l-en">Local runtime</span><span class="l-zh">本地运行时</span><small>Node 26 · Windows x64 first</small></div>
        <div class="system-stack">
          <div class="system-row primary"><span class="system-index">01</span><div><strong>Electron shell</strong><small>window · navigation · process lifecycle</small></div><span class="system-tag">host</span></div>
          <div class="system-link"><span></span><b>loopback web profile</b><span></span></div>
          <div class="system-row"><span class="system-index">02</span><div><strong>Official DeepSeek Harness</strong><small>sessions · tools · approvals · workspace</small></div><span class="system-tag">runtime</span></div>
          <div class="system-link"><span></span><b>your workspace</b><span></span></div>
          <div class="system-row dark"><span class="system-index">03</span><div><strong>Model endpoint</strong><small>DeepSeek official or configured compatible gateway</small></div><span class="system-tag">provider</span></div>
        </div>
        <div class="system-foot"><span>127.0.0.1</span><span>DSH_HOME</span><span>profile patch</span></div>
      </div>
    </section>
    <section class="trust-strip"><div class="wrap trust-grid"><div><strong>Node 26</strong><span><span class="l-en">runtime baseline</span><span class="l-zh">运行时基线</span></span></div><div><strong>Electron</strong><span><span class="l-en">desktop shell</span><span class="l-zh">桌面 Shell</span></span></div><div><strong>DSH</strong><span><span class="l-en">official agent runtime</span><span class="l-zh">官方 Agent 运行时</span></span></div><div><strong>MIT</strong><span><span class="l-en">open source</span><span class="l-zh">开源许可</span></span></div></div></section>
    <section class="wrap home-section"><div class="home-section-head"><div><div class="eyebrow"><span class="l-en">What VoltUI owns</span><span class="l-zh">VoltUI 负责什么</span></div><h2><span class="l-en">A narrow shell around a proven runtime.</span><span class="l-zh">围绕成熟运行时的窄边界 Shell。</span></h2></div></div><div class="value-grid mobile-rail"><article><span class="value-no">01</span><h3>Window safety</h3><p>Context isolation, sandboxing, loopback navigation and denied unmanaged popups.</p></article><article><span class="value-no">02</span><h3>Lifecycle</h3><p>Start the official profile as a managed child, surface its URL, and stop it on exit.</p></article><article><span class="value-no">03</span><h3>Brand patch</h3><p>Apply the Anyong/VoltUI profile overlay without forking the official DSH runtime.</p></article><article><span class="value-no">04</span><h3>Distribution</h3><p>Pin the latest verified DSH package and build Windows x64 artifacts reproducibly.</p></article></div></section>
    <section class="boundary-section"><div class="wrap"><div class="home-section-head"><div><div class="eyebrow"><span class="l-en">Explicit boundary</span><span class="l-zh">明确边界</span></div><h2><span class="l-en">One product runtime, no hidden second engine.</span><span class="l-zh">唯一产品运行时，不再维护第二套引擎。</span></h2></div></div><div class="boundary-grid"><article class="boundary yes"><h3>Included</h3><ul><li>Electron desktop shell</li><li>Official <code>@deepseek-ai/dsh</code> web profile</li><li>Node 26 and pnpm 12 toolchain</li><li>Windows x64 unsigned-review packaging</li></ul></article><article class="boundary no"><h3>Retired</h3><ul><li>Legacy CLI/TUI and desktop runtime</li><li>In-repository Harness packages</li><li>Former upstream synchronization</li><li>Legacy native npm and multi-channel release chain</li></ul></article></div></div></section>
  </main>
  <SiteFooter />
</Base>
